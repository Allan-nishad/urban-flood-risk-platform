# Urban Flood Risk Platform (V8) — Private Research Deployment Configuration
# Copy to .env and set a strong FLOODRISK_ADMIN_TOKEN before starting.

FLOODRISK_ADMIN_TOKEN=replace-with-strong-random-token
FLOODRISK_DB_PATH=data/state/floodrisk_v8.db
FLOODRISK_BACKUP_DIR=data/state/backups
FLOODRISK_MODEL_DIR=models/v8_experimental
FLOODRISK_REFRESH_INTERVAL_S=1800
FLOODRISK_ALLOWED_ORIGIN=http://127.0.0.1:8501
FLOODRISK_LOG_LEVEL=INFO
